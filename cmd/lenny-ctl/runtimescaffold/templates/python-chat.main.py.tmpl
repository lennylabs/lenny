"""Full-level chat runtime built on the Python runtime-author SDK
(``lenny-runtime``).

It follows the chat reference pattern: an empty workspace, no shell, and
LLM-proxy credential delivery. The runtime turns each inbound message
into a provider request and streams the response back.

The runtime is started with ``level="full"``, so the SDK opens the
CH-RUNTIMEOPS. The ``on_credentials_rotated`` callback is where the
runtime rebinds a session's provider client after that session's
credential lease rotates. Each session's credential file is named by the
``credentialsPath`` member of that session's ``session_start`` frame, and
the SDK has already re-read the file the rotation event names into the
session's bundle by the time the callback runs.

The message handler is an echo placeholder. Replace
:meth:`on_message` with a provider call: read the current credential
bundle, send a provider-dialect request through the LLM proxy, and
return the response as output parts.

Exit codes: 0 success, 1 runtime error, 2 protocol error.
"""

from __future__ import annotations

import sys

from lenny_runtime import (
    CreateRequest,
    CredentialBundle,
    HandlerTools,
    LifecycleHooks,
    Message,
    ProtocolError,
    Reply,
    RunOptions,
    TerminationReason,
    run,
    text,
)

_EXIT_OK = 0
_EXIT_RUNTIME_ERROR = 1
_EXIT_PROTOCOL_ERROR = 2


class RuntimeHandler:
    """Full-level chat handler.

    The message path is an echo placeholder; the chat behavior belongs
    in :meth:`on_message`.
    """

    def on_create(self, req: CreateRequest) -> None:
        """Receive the session's context snapshot from its
        ``session_start``.

        The create request carries the session's initial credential
        bundle for the provider lease.
        """

    def on_message(self, msg: Message, tools: HandlerTools) -> Reply:
        """Echo the inbound parts.

        Replace this body with a provider call routed through the LLM
        proxy.
        """
        out = []
        for part in msg.envelope.input:
            if part.type == "text" and part.inline:
                out.append(text(f"[{{.Name}} seq={msg.sequence}] {part.inline}"))
            else:
                out.append(part)
        return Reply(parts=out, final=True)

    def on_terminate(self, session_id: str, reason: TerminationReason) -> None:
        """Run once when the session ends. This skeleton has no teardown."""


def _on_checkpoint(session_id: str, checkpoint_id: str) -> None:
    """Quiesce output before the SDK replies checkpoint_ready.

    A chat runtime stops streaming here.
    """


def _on_interrupt(session_id: str, interrupt_id: str) -> None:
    """Bring the runtime to a safe stop point before the SDK replies
    interrupt_acknowledged."""


def _on_credentials_rotated(session_id: str, creds: CredentialBundle | None) -> None:
    """Rebind the provider client to the refreshed bundle.

    The SDK has already re-read the credential file by the time this
    callback runs.
    """


def main() -> None:
    """Entry point: run the chat handler at the Full level."""
    options = RunOptions(
        level="full",
        lifecycle=LifecycleHooks(
            on_checkpoint=_on_checkpoint,
            on_interrupt=_on_interrupt,
            on_credentials_rotated=_on_credentials_rotated,
        ),
    )
    try:
        run(RuntimeHandler(), options)
    except ProtocolError as err:
        sys.stderr.write(f"{err}\n")
        sys.exit(_EXIT_PROTOCOL_ERROR)
    except Exception as err:  # noqa: BLE001 — top-level exit boundary
        sys.stderr.write(f"{err}\n")
        sys.exit(_EXIT_RUNTIME_ERROR)
    sys.exit(_EXIT_OK)


if __name__ == "__main__":
    main()
