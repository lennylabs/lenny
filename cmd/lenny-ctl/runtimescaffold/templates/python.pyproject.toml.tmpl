[project]
name = "runtime-{{.Name}}"
version = "0.1.0"
description = "Lenny agent runtime {{.Name}}"
requires-python = ">=3.10"
license = { text = "MIT" }
dependencies = ["lenny-runtime>=0.1.0"]

[project.optional-dependencies]
dev = ["mypy>=1.8"]

[tool.mypy]
python_version = "3.10"
strict = true
files = ["main.py"]
