// Command {{.Name}} is a Basic-level Lenny agent runtime. It implements
// the adapter binary protocol directly, with no Lenny SDK dependency:
// read a JSON Lines frame, switch on the frame type, write a response
// frame, and flush.
//
// Basic level is the smallest viable runtime. It has no platform MCP
// access and no lifecycle channel. The contract is the four frame types
// handled below: message, heartbeat, shutdown, and unknown (ignored for
// forward compatibility).
//
// Transport: the §4.7 embedded deployment model runs this binary as the
// container's own process with the adapter's frames on stdin/stdout. The
// §4.7 sidecar deployment model runs the adapter in a separate container
// with no stdin attached to this one; the adapter instead passes its
// abstract Unix socket name in the LENNY_ADAPTER_SOCKET environment
// variable, and this runtime dials that socket and exchanges the same
// frames over the connection. openTransport below resolves which one
// applies; the frame loop in run is identical either way.
//
// Replace the body of handleMessage with a model call to build a real
// agent. The rest of the loop is the protocol and stays unchanged.
//
// Exit codes: 0 success, 1 runtime error, 2 protocol error.
package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"io"
	"net"
	"os"
	"strings"
	"time"
)

const (
	exitOK            = 0
	exitRuntimeError  = 1
	exitProtocolError = 2
)

// adapterSocketEnvVar names the §4.7 sidecar deployment model's runtime
// transport selector: the adapter passes its abstract Unix socket name
// to the runtime container in this environment variable. Absent, the
// runtime uses the stdin/stdout transport instead.
const adapterSocketEnvVar = "LENNY_ADAPTER_SOCKET"

// dialTimeout bounds how long openTransport waits for the adapter's
// socket listener to accept a connection. The adapter spawns the
// runtime container after it has already bound the socket, but this
// process may still race the listener at startup; the bounded retry
// absorbs that race.
const dialTimeout = 5 * time.Second

// frame is the common envelope for every inbound JSON Lines frame. Only
// the type field is read first; the typed decode happens per branch.
type frame struct {
	Type string `json:"type"`
}

// message is the inbound message frame. Basic-level runtimes read only
// the id and the input parts.
type message struct {
	ID    string `json:"id"`
	Input []part `json:"input"`
}

// part is one content part of a message or response. Basic-level
// runtimes need only the type and inline fields.
type part struct {
	Type   string `json:"type"`
	Inline string `json:"inline,omitempty"`
}

// shutdownFrame is the inbound shutdown frame. The runtime exits before
// deadlineMs elapses.
type shutdownFrame struct {
	DeadlineMS int `json:"deadlineMs"`
}

// response is the outbound response frame for a message.
type response struct {
	Type   string `json:"type"`
	Output []part `json:"output"`
}

// heartbeatAck is the outbound acknowledgement for a heartbeat frame.
type heartbeatAck struct {
	Type string `json:"type"`
}

func main() {
	in, out, closeTransport, err := openTransport()
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(exitRuntimeError)
	}
	defer closeTransport()

	if err := run(in, out); err != nil {
		fmt.Fprintln(os.Stderr, err)
		if _, ok := err.(protocolError); ok {
			os.Exit(exitProtocolError)
		}
		os.Exit(exitRuntimeError)
	}
	os.Exit(exitOK)
}

// protocolError marks a non-recoverable inbound-format violation.
type protocolError struct{ msg string }

func (e protocolError) Error() string { return "protocol error: " + e.msg }

// openTransport resolves the byte transport this runtime exchanges
// JSON Lines frames over: the abstract Unix socket named by
// adapterSocketEnvVar under the §4.7 sidecar deployment model, or
// stdin/stdout otherwise (the embedded deployment model, and the
// contract transport `lenny runtime validate` and the conformance
// harness drive directly). The returned close func releases the socket
// connection; it is a no-op for the stdin/stdout transport.
func openTransport() (io.Reader, io.Writer, func(), error) {
	socket := strings.TrimSpace(os.Getenv(adapterSocketEnvVar))
	if socket == "" {
		return os.Stdin, os.Stdout, func() {}, nil
	}
	addr := socket
	if strings.HasPrefix(socket, "@") {
		// A Linux abstract address begins with "@"; the kernel resolves
		// it once the leading byte is replaced with NUL.
		addr = "\x00" + socket[1:]
	}
	deadline := time.Now().Add(dialTimeout)
	var lastErr error
	for {
		var d net.Dialer
		conn, err := d.Dial("unix", addr)
		if err == nil {
			return conn, conn, func() { _ = conn.Close() }, nil
		}
		lastErr = err
		if time.Now().After(deadline) {
			return nil, nil, nil, fmt.Errorf("dial adapter socket %q: %w", socket, lastErr)
		}
		time.Sleep(100 * time.Millisecond)
	}
}

// run is the Basic-level frame loop. It reads newline-delimited JSON
// from in and writes newline-delimited JSON to out, flushing after
// every write. It returns when in reaches EOF or a shutdown frame
// arrives.
func run(in io.Reader, out io.Writer) error {
	scanner := bufio.NewScanner(in)
	// Raise the scanner buffer ceiling: a message frame may carry a
	// large inline part.
	scanner.Buffer(make([]byte, 64*1024), 50*1024*1024)
	w := bufio.NewWriter(out)
	enc := json.NewEncoder(w)
	enc.SetEscapeHTML(false)

	seq := 0
	for scanner.Scan() {
		line := scanner.Bytes()
		if len(line) == 0 {
			continue
		}
		var f frame
		if err := json.Unmarshal(line, &f); err != nil {
			return protocolError{msg: fmt.Sprintf("malformed JSON Lines frame: %v", err)}
		}
		switch f.Type {
		case "message":
			seq++
			if err := handleMessage(enc, w, line, seq); err != nil {
				return err
			}
		case "heartbeat":
			// A heartbeat must be acknowledged within 10 seconds or the
			// adapter escalates the runtime as unresponsive.
			if err := writeFrame(enc, w, heartbeatAck{Type: "heartbeat_ack"}); err != nil {
				return err
			}
		case "shutdown":
			var sd shutdownFrame
			if err := json.Unmarshal(line, &sd); err != nil {
				return protocolError{msg: fmt.Sprintf("malformed shutdown frame: %v", err)}
			}
			// Exit cleanly. A real runtime flushes pending work within
			// sd.DeadlineMS before returning.
			return nil
		default:
			// Ignore unknown frame types for forward compatibility.
		}
	}
	if err := scanner.Err(); err != nil {
		return protocolError{msg: fmt.Sprintf("stdin read error: %v", err)}
	}
	return nil
}

// handleMessage decodes one message frame and writes the response. This
// echo placeholder prefixes each text part with the sequence number;
// replace the body with a model call to build a real agent.
func handleMessage(enc *json.Encoder, w *bufio.Writer, line []byte, seq int) error {
	var m message
	if err := json.Unmarshal(line, &m); err != nil {
		return protocolError{msg: fmt.Sprintf("malformed message frame: %v", err)}
	}
	out := make([]part, 0, len(m.Input))
	for _, p := range m.Input {
		if p.Type == "text" && p.Inline != "" {
			out = append(out, part{
				Type:   "text",
				Inline: fmt.Sprintf("[{{.Name}} seq=%d] %s", seq, p.Inline),
			})
			continue
		}
		out = append(out, p)
	}
	return writeFrame(enc, w, response{Type: "response", Output: out})
}

// writeFrame serializes one frame and flushes it. The adapter binary
// protocol requires a flush after every write so the frame reaches the
// adapter before the next read.
func writeFrame(enc *json.Encoder, w *bufio.Writer, v any) error {
	if err := enc.Encode(v); err != nil {
		return fmt.Errorf("write frame: %w", err)
	}
	return w.Flush()
}
