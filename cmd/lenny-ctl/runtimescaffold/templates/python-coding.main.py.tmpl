"""Full-level coding-agent runtime built on the Python runtime-author
SDK (``lenny-runtime``).

It follows the shared coding-agent pattern: the session workspace is the
repository root at ``/workspace/slots/{sessionId}/current``, derived per
session from the session identifier the message carries, and artifacts
that must survive teardown are written to ``/workspace/output``.

The runtime is started with ``level="full"``, so the SDK opens the
lifecycle channel and completes the ``lifecycle_capabilities`` /
``lifecycle_support`` handshake in addition to the Standard-level MCP
setup. The lifecycle callbacks below are where a real coding agent
quiesces output for a checkpoint, reaches a safe interrupt point, and
rebinds rotated credentials.

The message handler is an echo placeholder. Replace
:meth:`on_message` with the agent loop: read the workspace under
``workspace_root(msg.session_id)``, run the model and tools, and write
artifacts under ``WORKSPACE_OUTPUT``.

Exit codes: 0 success, 1 runtime error, 2 protocol error.
"""

from __future__ import annotations

import sys

from lenny_runtime import (
    CreateRequest,
    CredentialBundle,
    HandlerTools,
    LifecycleHooks,
    Message,
    ProtocolError,
    Reply,
    RunOptions,
    TerminationReason,
    run,
    text,
)

_EXIT_OK = 0
_EXIT_RUNTIME_ERROR = 1
_EXIT_PROTOCOL_ERROR = 2

# WORKSPACE_OUTPUT is the durable artifact directory of the shared
# coding-agent pattern.
WORKSPACE_OUTPUT = "/workspace/output"


def workspace_root(session_id: str) -> str:
    """Return the working directory of the session named by ``session_id``.

    Every session has its own workspace tree and there is no pod-global
    workspace path, so the agent loop derives its root from the session
    identifier the SDK delivers on each message.

    spec: §6.4 -- /workspace/slots/{sessionId}/current is the session cwd
    """
    return f"/workspace/slots/{session_id}/current"


class RuntimeHandler:
    """Full-level coding-agent handler.

    The message path is an echo placeholder; the coding behavior belongs
    in :meth:`on_message`.
    """

    def __init__(self) -> None:
        self._seq = 0

    def on_create(self, req: CreateRequest) -> None:
        """Receive the task-scoped context snapshot.

        A coding agent reads ``req.workspace_plan`` here to learn which
        sources were staged and which setup commands ran.
        """

    def on_message(self, msg: Message, tools: HandlerTools) -> Reply:
        """Echo the inbound parts.

        Replace this body with the agent loop over the workspace at
        ``workspace_root(msg.session_id)``.
        """
        self._seq += 1
        out = []
        for part in msg.envelope.input:
            if part.type == "text" and part.inline:
                out.append(text(f"[{{.Name}} seq={self._seq}] {part.inline}"))
            else:
                out.append(part)
        return Reply(parts=out, final=True)

    def on_terminate(self, reason: TerminationReason) -> None:
        """Run once when the session ends.

        Flush pending artifacts to ``WORKSPACE_OUTPUT`` before
        returning.
        """


def _on_checkpoint(checkpoint_id: str) -> None:
    """Quiesce output before the SDK replies checkpoint_ready.

    Stop writing to the workspace here.
    """


def _on_interrupt(interrupt_id: str) -> None:
    """Bring the runtime to a safe stop point before the SDK replies
    interrupt_acknowledged."""


def _on_credentials_rotated(creds: CredentialBundle | None) -> None:
    """Rebind the upstream client to the refreshed bundle.

    The SDK has already re-read the credential file by the time this
    callback runs.
    """


def main() -> None:
    """Entry point: run the coding-agent handler at the Full level."""
    options = RunOptions(
        level="full",
        lifecycle=LifecycleHooks(
            on_checkpoint=_on_checkpoint,
            on_interrupt=_on_interrupt,
            on_credentials_rotated=_on_credentials_rotated,
        ),
    )
    try:
        run(RuntimeHandler(), options)
    except ProtocolError as err:
        sys.stderr.write(f"{err}\n")
        sys.exit(_EXIT_PROTOCOL_ERROR)
    except Exception as err:  # noqa: BLE001 — top-level exit boundary
        sys.stderr.write(f"{err}\n")
        sys.exit(_EXIT_RUNTIME_ERROR)
    sys.exit(_EXIT_OK)


if __name__ == "__main__":
    main()
