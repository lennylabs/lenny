// Command {{.Name}} is a Full-level coding-agent runtime built on the
// TypeScript runtime-author SDK. It follows the shared coding-agent
// pattern: the session workspace is the repository root at
// /workspace/current, and artifacts that must survive teardown are
// written to /workspace/output.
//
// The runtime is started with level "full", so the SDK opens the
// lifecycle channel and completes the lifecycle_capabilities /
// lifecycle_support handshake in addition to the Standard-level MCP
// setup. The lifecycle callbacks below are where a real coding agent
// quiesces output for a checkpoint, reaches a safe interrupt point, and
// rebinds rotated credentials.
//
// The message handler is an echo placeholder. Replace onMessage with
// the agent loop: read the workspace under WORKSPACE_CURRENT, run the
// model and tools, and write artifacts under WORKSPACE_OUTPUT.
//
// Exit codes: 0 success, 1 runtime error, 2 protocol error.

import { isProtocolError, run, text } from "@lennylabs/runtime-sdk";
import type { Handler, Message, Reply } from "@lennylabs/runtime-sdk";

const EXIT_OK = 0;
const EXIT_RUNTIME_ERROR = 1;
const EXIT_PROTOCOL_ERROR = 2;

// Workspace paths for the shared coding-agent pattern. The gateway
// materializes the session workspace under WORKSPACE_CURRENT before the
// first message; the agent writes durable artifacts under
// WORKSPACE_OUTPUT.
const WORKSPACE_CURRENT = "/workspace/current";
const WORKSPACE_OUTPUT = "/workspace/output";

// Handler is a Full-level coding-agent handler. The message path is an
// echo placeholder; the coding behavior belongs in onMessage.
class RuntimeHandler implements Handler {
  private seq = 0;

  // onCreate receives the task-scoped context snapshot. A coding agent
  // reads the workspace plan here to learn which sources were staged.
  onCreate(): void {}

  // onMessage echoes the inbound parts. Replace this body with the
  // agent loop over the workspace at WORKSPACE_CURRENT.
  onMessage(msg: Message): Reply {
    this.seq += 1;
    const input = msg.envelope.input ?? [];
    const out = input.map((p) =>
      p.type === "text" && p.inline
        ? text(`[{{.Name}} seq=${this.seq}] ${p.inline}`)
        : p,
    );
    return { parts: out, final: true };
  }

  // onTerminate runs once when the session ends. Flush pending
  // artifacts to WORKSPACE_OUTPUT before returning.
  onTerminate(): void {}
}

run(new RuntimeHandler(), {
  level: "full",
  lifecycle: {
    // A checkpoint quiesces output before the SDK replies
    // checkpoint_ready. Stop writing to the workspace here.
    onCheckpoint() {},
    // An interrupt brings the runtime to a safe stop point before the
    // SDK replies interrupt_acknowledged.
    onInterrupt() {},
    // On rotation the SDK has already re-read the credential file;
    // rebind the upstream client to the refreshed bundle here.
    onCredentialsRotated() {},
  },
}).then(
  () => process.exit(EXIT_OK),
  (err: unknown) => {
    process.stderr.write(String(err) + "\n");
    process.exit(isProtocolError(err) ? EXIT_PROTOCOL_ERROR : EXIT_RUNTIME_ERROR);
  },
);

// WORKSPACE_CURRENT and WORKSPACE_OUTPUT are exported so adjacent
// modules in the agent loop can import the canonical paths.
export { WORKSPACE_CURRENT, WORKSPACE_OUTPUT };
