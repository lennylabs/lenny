# Makefile for the {{.Name}} runtime.
#
# IMAGE is the container reference the build, push, and publish targets
# operate on. Override it on the command line:
#
#   make build IMAGE=ghcr.io/acme/runtime-{{.Name}}:dev

IMAGE ?= {{.Image}}

.PHONY: build test push publish

# build compiles a static binary and the container image.
build:
	CGO_ENABLED=0 go build -trimpath -o bin/{{.Name}} .
	docker build -t $(IMAGE) .

# test runs the Go unit tests.
test:
	go test ./...

# push pushes the built image to its registry.
push:
	docker push $(IMAGE)

# publish pushes the image and registers the runtime with the gateway.
# It requires LENNY_API_URL and an admin token in LENNY_API_TOKEN.
publish:
	lenny runtime publish {{.Name}} --image $(IMAGE)
