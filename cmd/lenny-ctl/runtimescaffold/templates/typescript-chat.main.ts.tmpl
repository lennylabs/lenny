// Command {{.Name}} is a Full-level chat runtime built on the
// TypeScript runtime-author SDK. It follows the chat reference pattern:
// an empty workspace, no shell, and LLM-proxy credential delivery. The
// runtime turns each inbound message into a provider request and
// streams the response back.
//
// The runtime is started with level "full", so the SDK opens the
// lifecycle channel. The onCredentialsRotated callback is where the
// runtime rebinds its provider client after the credential lease
// rotates; the SDK has already re-read /run/lenny/credentials.json by
// the time the callback runs.
//
// The message handler is an echo placeholder. Replace onMessage with a
// provider call: read the current credential bundle, send a
// provider-dialect request through the LLM proxy, and return the
// response as output parts.
//
// Exit codes: 0 success, 1 runtime error, 2 protocol error.

import { isProtocolError, run, text } from "@lennylabs/runtime-sdk";
import type { Handler, Message, Reply } from "@lennylabs/runtime-sdk";

const EXIT_OK = 0;
const EXIT_RUNTIME_ERROR = 1;
const EXIT_PROTOCOL_ERROR = 2;

// Handler is a Full-level chat handler. The message path is an echo
// placeholder; the chat behavior belongs in onMessage.
class RuntimeHandler implements Handler {
  private seq = 0;

  // onCreate receives the task-scoped context snapshot. The create
  // request carries the initial credential bundle for the provider
  // lease.
  onCreate(): void {}

  // onMessage echoes the inbound parts. Replace this body with a
  // provider call routed through the LLM proxy.
  onMessage(msg: Message): Reply {
    this.seq += 1;
    const input = msg.envelope.input ?? [];
    const out = input.map((p) =>
      p.type === "text" && p.inline
        ? text(`[{{.Name}} seq=${this.seq}] ${p.inline}`)
        : p,
    );
    return { parts: out, final: true };
  }

  // onTerminate runs once when the session ends. This skeleton has no
  // teardown.
  onTerminate(): void {}
}

run(new RuntimeHandler(), {
  level: "full",
  lifecycle: {
    // A checkpoint quiesces output before the SDK replies
    // checkpoint_ready. A chat runtime stops streaming here.
    onCheckpoint() {},
    // An interrupt brings the runtime to a safe stop point before the
    // SDK replies interrupt_acknowledged.
    onInterrupt() {},
    // On rotation the SDK has already re-read the credential file;
    // rebind the provider client to the refreshed bundle here.
    onCredentialsRotated() {},
  },
}).then(
  () => process.exit(EXIT_OK),
  (err: unknown) => {
    process.stderr.write(String(err) + "\n");
    process.exit(isProtocolError(err) ? EXIT_PROTOCOL_ERROR : EXIT_RUNTIME_ERROR);
  },
);
