shutdownSequence.run:
  q.stopListener
  q.waitTerminalWork
  q.sessions.Close
  defer cancel
  range q.closers
finalShutdownSteps:
  trace
  llm-proxy
  gateway-control
  postgres
  sqlite
  redis
  openfeature
