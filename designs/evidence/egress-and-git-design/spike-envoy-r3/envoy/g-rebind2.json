         },
         {
          "address_prefix": "240.0.0.0",
          "prefix_len": 4
         },
         {
          "address_prefix": "::",
          "prefix_len": 128
         },
         {
          "address_prefix": "::1",
          "prefix_len": 128
         },
         {
          "address_prefix": "::ffff:0:0",
          "prefix_len": 96
         },
         {
          "address_prefix": "64:ff9b::",
