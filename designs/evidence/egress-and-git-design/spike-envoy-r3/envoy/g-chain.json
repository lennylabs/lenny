{
 "admin": {
  "address": {
   "socket_address": {
    "address": "0.0.0.0",
    "port_value": 9901
   }
  }
 },
 "static_resources": {
  "listeners": [
   {
    "name": "egress",
    "address": {
     "socket_address": {
      "address": "::",
      "port_value": 3128,
      "ipv4_compat": true
     }
    },
    "filter_chains": [
     {
      "filters": [
       {
        "name": "envoy.filters.network.http_connection_manager",
        "typed_config": {
         "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
         "stat_prefix": "egress",
         "codec_type": "HTTP1",
         "upgrade_configs": [
          {
           "upgrade_type": "CONNECT"
          }
         ],
         "stream_idle_timeout": "300s",
         "delayed_close_timeout": "0.1s",
         "access_log_options": {
          "flush_log_on_tunnel_successfully_established": true
         },
         "access_log": [
          {
           "name": "envoy.access_loggers.stdout",
           "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog",
            "log_format": {
             "json_format": {
              "t": "%START_TIME%",
              "method": "%REQ(:METHOD)%",
              "authority": "%REQ(:AUTHORITY)%",
              "code": "%RESPONSE_CODE%",
              "flags": "%RESPONSE_FLAGS%",
              "details": "%RESPONSE_CODE_DETAILS%",
              "dur_ms": "%DURATION%",
              "peer": "%DOWNSTREAM_REMOTE_ADDRESS%",
              "up_cluster": "%UPSTREAM_CLUSTER%",
              "up_host": "%UPSTREAM_HOST%",
              "up_fail": "%UPSTREAM_TRANSPORT_FAILURE_REASON%",
              "rx": "%BYTES_RECEIVED%",
              "tx": "%BYTES_SENT%",
              "route_hdr": "%REQ(x-lenny-route)%",
              "tenant": "%DYNAMIC_METADATA(envoy.filters.http.ext_authz:tenant)%",
              "md_upstream": "%DYNAMIC_METADATA(envoy.filters.http.ext_authz:x-lenny-upstream)%",
              "md_tenant_h": "%DYNAMIC_METADATA(envoy.filters.http.ext_authz:x-lenny-tenant)%",
              "resp_pa": "%RESP(proxy-authenticate)%",
              "conn_term": "%CONNECTION_TERMINATION_DETAILS%",
              "sni_expect": "%FILTER_STATE(lenny.authority:PLAIN)%"
             }
            }
           }
          }
         ],
         "http_filters": [
          {
           "name": "envoy.filters.http.custom_response",
           "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.filters.http.custom_response.v3.CustomResponse"
           }
          },
          {
           "name": "envoy.filters.http.ext_authz",
           "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.filters.http.ext_authz.v3.ExtAuthz",
            "http_service": {
             "server_uri": {
              "uri": "http://198.18.0.11:9001",
              "cluster": "authz_http",
              "timeout": "2s"
             },
             "path_prefix": "/check",
             "authorization_request": {
              "headers_to_add": [
               {
                "key": "x-lenny-peer",
                "value": "%DOWNSTREAM_REMOTE_ADDRESS%"
               }
              ]
             },
             "authorization_response": {
              "allowed_upstream_headers": {
               "patterns": [
                {
                 "exact": "x-lenny-route"
                },
                {
                 "exact": "proxy-authorization"
                }
               ]
              },
              "allowed_client_headers": {
               "patterns": [
                {
                 "exact": "x-lenny-deny-reason"
                },
                {
                 "exact": "proxy-authenticate"
                }
               ]
              },
              "dynamic_metadata_from_headers": {
               "patterns": [
                {
                 "exact": "x-lenny-upstream"
                },
                {
                 "exact": "x-lenny-tenant"
                }
               ]
              }
             }
            },
            "allowed_headers": {
             "patterns": [
              {
               "exact": "proxy-authorization"
              }
             ]
            },
            "failure_mode_allow": false,
            "clear_route_cache": true,
            "status_on_error": {
             "code": "ServiceUnavailable"
            }
           }
          },
          {
           "name": "envoy.filters.http.dynamic_forward_proxy",
           "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.filters.http.dynamic_forward_proxy.v3.FilterConfig",
            "dns_cache_config": {
             "name": "egress_dns",
             "dns_lookup_family": "ALL",
             "dns_refresh_rate": "60s",
             "dns_min_refresh_rate": "5s",
             "host_ttl": "300s",
             "resolved_address_filter": {
              "ranges": [
               {
                "address_prefix": "0.0.0.0",
                "prefix_len": 8
               },
               {
                "address_prefix": "10.0.0.0",
                "prefix_len": 8
               },
               {
                "address_prefix": "100.64.0.0",
                "prefix_len": 10
               },
               {
                "address_prefix": "127.0.0.0",
                "prefix_len": 8
               },
               {
                "address_prefix": "169.254.0.0",
                "prefix_len": 16
               },
               {
                "address_prefix": "172.16.0.0",
                "prefix_len": 12
               },
               {
                "address_prefix": "192.0.0.0",
                "prefix_len": 24
               },
               {
                "address_prefix": "192.168.0.0",
                "prefix_len": 16
               },
               {
                "address_prefix": "224.0.0.0",
                "prefix_len": 4
               },
               {
                "address_prefix": "240.0.0.0",
                "prefix_len": 4
               },
               {
                "address_prefix": "::",
                "prefix_len": 128
               },
               {
                "address_prefix": "::1",
                "prefix_len": 128
               },
               {
                "address_prefix": "::ffff:0:0",
                "prefix_len": 96
               },
               {
                "address_prefix": "64:ff9b::",
                "prefix_len": 96
               },
               {
                "address_prefix": "fc00::",
                "prefix_len": 7
               },
               {
                "address_prefix": "fe80::",
                "prefix_len": 10
               },
               {
                "address_prefix": "ff00::",
                "prefix_len": 8
               }
              ]
             }
            }
           }
          },
          {
           "name": "envoy.filters.http.router",
           "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router",
            "suppress_envoy_headers": true
           }
          }
         ],
         "route_config": {
          "name": "egress",
          "virtual_hosts": [
           {
            "name": "all",
            "domains": [
             "*"
            ],
            "routes": [
             {
              "match": {
               "connect_matcher": {},
               "headers": [
                {
                 "name": "x-lenny-route",
                 "string_match": {
                  "exact": "direct"
                 }
                }
               ]
              },
              "route": {
               "cluster": "dfp",
               "upgrade_configs": [
                {
                 "upgrade_type": "CONNECT",
                 "connect_config": {}
                }
               ],
               "max_stream_duration": {
                "max_stream_duration": "3600s"
               }
              }
             },
             {
              "match": {
               "connect_matcher": {},
               "headers": [
                {
                 "name": "x-lenny-route",
                 "string_match": {
                  "exact": "upstream-md"
                 }
                }
               ]
              },
              "route": {
               "cluster": "upstream_dynamic_md",
               "upgrade_configs": [
                {
                 "upgrade_type": "CONNECT"
                }
               ],
               "max_stream_duration": {
                "max_stream_duration": "3600s"
               }
              },
              "request_headers_to_remove": [
               "x-request-id",
               "x-forwarded-proto",
               "x-lenny-route",
               "x-lenny-upstream",
               "user-agent"
              ],
              "typed_per_filter_config": {
               "envoy.filters.http.custom_response": {
                "@type": "type.googleapis.com/envoy.extensions.filters.http.custom_response.v3.CustomResponse",
                "custom_response_matcher": {
                 "matcher_list": {
                  "matchers": [
                   {
                    "predicate": {
                     "single_predicate": {
                      "input": {
                       "name": "status_code",
                       "typed_config": {
                        "@type": "type.googleapis.com/envoy.type.matcher.v3.HttpResponseStatusCodeMatchInput"
                       }
                      },
                      "value_match": {
                       "exact": "407"
                      }
                     }
                    },
                    "on_match": {
                     "action": {
                      "name": "lenny_upstream_407",
                      "typed_config": {
                       "@type": "type.googleapis.com/envoy.extensions.http.custom_response.local_response_policy.v3.LocalResponsePolicy",
                       "status_code": 502,
                       "body": {
                        "inline_string": "upstream proxy rejected the egress credential\n"
                       },
                       "response_headers_to_add": [
                        {
                         "header": {
                          "key": "x-lenny-upstream-status",
                          "value": "407"
                         },
                         "append_action": "OVERWRITE_IF_EXISTS_OR_ADD"
                        }
                       ]
                      }
                     }
                    }
                   },
                   {
                    "predicate": {
                     "single_predicate": {
                      "input": {
                       "name": "status_code",
                       "typed_config": {
                        "@type": "type.googleapis.com/envoy.type.matcher.v3.HttpResponseStatusCodeMatchInput"
                       }
                      },
                      "value_match": {
                       "exact": "403"
                      }
                     }
                    },
                    "on_match": {
                     "action": {
                      "name": "lenny_upstream_403",
                      "typed_config": {
                       "@type": "type.googleapis.com/envoy.extensions.http.custom_response.local_response_policy.v3.LocalResponsePolicy",
                       "status_code": 403,
                       "body": {
                        "inline_string": "upstream proxy denied the destination\n"
                       },
                       "response_headers_to_add": [
                        {
                         "header": {
                          "key": "x-lenny-upstream-status",
                          "value": "403"
                         },
                         "append_action": "OVERWRITE_IF_EXISTS_OR_ADD"
                        }
                       ]
                      }
                     }
                    }
                   }
                  ]
                 }
                }
               }
              }
             },
             {
              "match": {
               "connect_matcher": {}
              },
              "direct_response": {
               "status": 403,
               "body": {
                "inline_string": "no route decision\n"
               }
              }
             },
             {
              "match": {
               "prefix": "/"
              },
              "direct_response": {
               "status": 405,
               "body": {
                "inline_string": "CONNECT only\n"
               }
              }
             }
            ]
           }
          ]
         }
        }
       }
      ]
     }
    ]
   }
  ],
  "clusters": [
   {
    "name": "authz",
    "type": "STATIC",
    "connect_timeout": "1s",
    "typed_extension_protocol_options": {
     "envoy.extensions.upstreams.http.v3.HttpProtocolOptions": {
      "@type": "type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions",
      "explicit_http_config": {
       "http2_protocol_options": {}
      }
     }
    },
    "load_assignment": {
     "cluster_name": "authz",
     "endpoints": [
      {
       "lb_endpoints": [
        {
         "endpoint": {
          "address": {
           "socket_address": {
            "address": "198.18.0.11",
            "port_value": 9000
           }
          }
         }
        }
       ]
      }
     ]
    }
   },
   {
    "name": "authz_http",
    "type": "STATIC",
    "connect_timeout": "1s",
    "typed_extension_protocol_options": {
     "envoy.extensions.upstreams.http.v3.HttpProtocolOptions": {
      "@type": "type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions",
      "explicit_http_config": {
       "http2_protocol_options": {}
      }
     }
    },
    "load_assignment": {
     "cluster_name": "authz_http",
     "endpoints": [
      {
       "lb_endpoints": [
        {
         "endpoint": {
          "address": {
           "socket_address": {
            "address": "198.18.0.11",
            "port_value": 9003
           }
          }
         }
        }
       ]
      }
     ]
    }
   },
   {
    "name": "dfp",
    "connect_timeout": "5s",
    "lb_policy": "CLUSTER_PROVIDED",
    "cluster_type": {
     "name": "envoy.clusters.dynamic_forward_proxy",
     "typed_config": {
      "@type": "type.googleapis.com/envoy.extensions.clusters.dynamic_forward_proxy.v3.ClusterConfig",
      "dns_cache_config": {
       "name": "egress_dns",
       "dns_lookup_family": "ALL",
       "dns_refresh_rate": "60s",
       "dns_min_refresh_rate": "5s",
       "host_ttl": "300s",
       "resolved_address_filter": {
        "ranges": [
         {
          "address_prefix": "0.0.0.0",
          "prefix_len": 8
         },
         {
          "address_prefix": "10.0.0.0",
          "prefix_len": 8
         },
         {
          "address_prefix": "100.64.0.0",
          "prefix_len": 10
         },
         {
          "address_prefix": "127.0.0.0",
          "prefix_len": 8
         },
         {
          "address_prefix": "169.254.0.0",
          "prefix_len": 16
         },
         {
          "address_prefix": "172.16.0.0",
          "prefix_len": 12
         },
         {
          "address_prefix": "192.0.0.0",
          "prefix_len": 24
         },
         {
          "address_prefix": "192.168.0.0",
          "prefix_len": 16
         },
         {
          "address_prefix": "224.0.0.0",
          "prefix_len": 4
         },
         {
          "address_prefix": "240.0.0.0",
          "prefix_len": 4
         },
         {
          "address_prefix": "::",
          "prefix_len": 128
         },
         {
          "address_prefix": "::1",
          "prefix_len": 128
         },
         {
          "address_prefix": "::ffff:0:0",
          "prefix_len": 96
         },
         {
          "address_prefix": "64:ff9b::",
          "prefix_len": 96
         },
         {
          "address_prefix": "fc00::",
          "prefix_len": 7
         },
         {
          "address_prefix": "fe80::",
          "prefix_len": 10
         },
         {
          "address_prefix": "ff00::",
          "prefix_len": 8
         }
        ]
       }
      }
     }
    }
   },
   {
    "name": "upstream_dynamic_md",
    "type": "ORIGINAL_DST",
    "connect_timeout": "5s",
    "lb_policy": "CLUSTER_PROVIDED",
    "original_dst_lb_config": {
     "metadata_key": {
      "key": "envoy.filters.http.ext_authz",
      "path": [
       {
        "key": "x-lenny-upstream"
       }
      ]
     }
    }
   }
  ]
 }
}