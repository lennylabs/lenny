                {
                 "upgrade_type": "CONNECT",
                 "connect_config": {}
                }
               ],
               "max_stream_duration": {
                "max_stream_duration": "3600s"
               }
              }
             },
             {
              "match": {
               "connect_matcher": {}
              },
              "direct_response": {
               "status": 403,
               "body": {
                "inline_string": "no route decision\n"
               }
              }
             },
             {
              "match": {
               "prefix": "/"
              },
              "direct_response": {
               "status": 405,
               "body": {
                "inline_string": "CONNECT only\n"
               }
              }
             }
            ]
