            ],
            "routes": [
             {
              "match": {
               "connect_matcher": {},
               "headers": [
                {
                 "name": "x-lenny-route",
                 "string_match": {
                  "exact": "direct"
                 }
                }
               ]
              },
              "route": {
               "cluster": "dfp",
               "upgrade_configs": [
                {
                 "upgrade_type": "CONNECT",
                 "connect_config": {}
                }
               ],
               "max_stream_duration": {
                "max_stream_duration": "3600s"
               }
              }
