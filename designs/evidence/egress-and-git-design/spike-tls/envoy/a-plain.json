 "static_resources": {
  "listeners": [
   {
    "name": "egress",
    "address": {
     "socket_address": {
      "address": "::",
      "port_value": 3128,
      "ipv4_compat": true
     }
    },
    "filter_chains": [
     {
      "filters": [
       {
        "name": "envoy.filters.network.http_connection_manager",
        "typed_config": {
         "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
         "stat_prefix": "egress",
         "codec_type": "HTTP1",
         "upgrade_configs": [
          {
           "upgrade_type": "CONNECT"
          }
         ],
         "stream_idle_timeout": "300s",
         "delayed_close_timeout": "0.1s",
         "access_log_options": {
          "flush_log_on_tunnel_successfully_established": true
         },
         "access_log": [
          {
           "name": "envoy.access_loggers.stdout",
           "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog",
            "log_format": {
             "json_format": {
              "t": "%START_TIME%",
              "method": "%REQ(:METHOD)%",
              "authority": "%REQ(:AUTHORITY)%",
              "code": "%RESPONSE_CODE%",
              "flags": "%RESPONSE_FLAGS%",
              "details": "%RESPONSE_CODE_DETAILS%",
              "dur_ms": "%DURATION%",
              "peer": "%DOWNSTREAM_REMOTE_ADDRESS%",
              "up_cluster": "%UPSTREAM_CLUSTER%",
              "up_host": "%UPSTREAM_HOST%",
              "up_fail": "%UPSTREAM_TRANSPORT_FAILURE_REASON%",
              "rx": "%BYTES_RECEIVED%",
              "tx": "%BYTES_SENT%",
              "route_hdr": "%REQ(x-lenny-route)%",
              "tenant": "%DYNAMIC_METADATA(envoy.filters.http.ext_authz:tenant)%",
              "md_upstream": "%DYNAMIC_METADATA(envoy.filters.http.ext_authz:upstream)%",
              "md_tenant_h": "%DYNAMIC_METADATA(envoy.filters.http.ext_authz:x-lenny-tenant)%",
              "resp_pa": "%RESP(proxy-authenticate)%",
              "conn_term": "%CONNECTION_TERMINATION_DETAILS%",
              "sni_expect": "%FILTER_STATE(lenny.authority:PLAIN)%"
             }
            }
           }
          }
         ],
         "http_filters": [
          {
           "name": "envoy.filters.http.ext_authz",
           "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.filters.http.ext_authz.v3.ExtAuthz",
            "transport_api_version": "V3",
            "grpc_service": {
             "envoy_grpc": {
              "cluster_name": "authz"
             },
             "timeout": "2s"
            },
            "failure_mode_allow": false,
            "clear_route_cache": true,
            "status_on_error": {
             "code": "ServiceUnavailable"
            }
           }
          },
          {
           "name": "envoy.filters.http.set_filter_state",
           "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config",
            "on_request_headers": [
             {
              "object_key": "lenny.authority",
              "factory_key": "envoy.string",
              "format_string": {
               "text_format_source": {
                "inline_string": "%REQ(:AUTHORITY)%"
               },
               "omit_empty_values": true
              },
              "shared_with_upstream": "ONCE",
              "skip_if_empty": true
             },
             {
              "object_key": "lenny.sni_expect",
              "factory_key": "envoy.string",
              "format_string": {
