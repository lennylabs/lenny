               "x-forwarded-proto",
               "x-lenny-route",
               "x-lenny-upstream",
               "user-agent"
              ],
              "response_headers_to_remove": [
               "proxy-authenticate",
               "proxy-connection",
               "x-corp-policy",
               "x-corp-hint",
               "via"
              ]
