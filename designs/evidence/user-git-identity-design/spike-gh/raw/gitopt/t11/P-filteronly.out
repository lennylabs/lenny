### no-rewrite-push-main rc=0
$ GIT_CONFIG_GLOBAL=/dev/null GIT_SSL_CAINFO=/s/bundle.pem git -c user.email=a@b -c 'http.extraHeader=Authorization: Bearer USER-FILE-TOKEN' push -q https://ghes.example.test/acme/widgets.git HEAD:refs/heads/main 2>&1 | tail -1
