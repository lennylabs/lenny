### push-outside-with-own-token rc=0
$ git -c 'http.extraHeader=Authorization: Bearer USER-FILE-TOKEN' -c credential.helper=store push -q https://ghes.example.test/acme/secret.git HEAD:refs/heads/lenny/x 2>&1 | tail -1
