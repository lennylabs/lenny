### gh-credential-helper-push rc=0
$ git commit -q --allow-empty -m e; GH_ENTERPRISE_TOKEN=USER-FILE-TOKEN GH_HOST=ghes.example.test git -c 'credential.helper=!gh auth git-credential' push -q origin HEAD 2>&1 | tail -1

