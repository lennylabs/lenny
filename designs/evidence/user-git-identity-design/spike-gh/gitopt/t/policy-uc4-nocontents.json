{
 "ghes": {
  "mode": "deny",
  "matcher": "uc4",
  "restPrefix": "/api/v3/",
  "denyMutations": [
   "addPullRequestReview",
   "submitPullRequestReview",
   "updatePullRequestReview",
   "deletePullRequestReview",
   "dismissPullRequestReview",
   "mergePullRequest",
   "enablePullRequestAutoMerge",
   "disablePullRequestAutoMerge",
   "enqueuePullRequest",
   "dequeuePullRequest",
   "mergeBranch",
   "updatePullRequestBranch",
   "revertPullRequest",
   "createCommitOnBranch",
   "createRef",
   "updateRef",
   "updateRefs",
   "deleteRef",
   "createLinkedBranch",
   "approveDeployments",
   "rejectDeployments",
   "updateEnvironment",
   "deleteEnvironment",
   "createBranchProtectionRule",
   "updateBranchProtectionRule",
   "deleteBranchProtectionRule",
   "createRepositoryRuleset",
   "updateRepositoryRuleset",
   "deleteRepositoryRuleset"
  ],
  "stripHeaders": [
   "Authorization",
   "Private-Token",
   "Job-Token",
   "Deploy-Token",
   "X-Api-Key",
   "Cookie",
   "Proxy-Authorization"
  ],
  "uc4": {
   "default": "allow",
   "repoRoots": [
    "/repos/*/*",
    "/repositories/*"
   ],
   "rules": [
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/pulls/*/reviews/**"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/pulls/*/merge"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/pulls/*/merge-async"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/pulls/*/update-branch"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/merges"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/merge-upstream"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/git/refs/**"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/git/commits"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/git/trees"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/git/tags"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/branches/*/rename"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/actions/runs/*/pending_deployments"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/actions/runs/*/approve"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/actions/runs/*/deployment_protection_rule"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/actions/runs/*/force-cancel"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/environments/**"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/branches/*/protection/**"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/rulesets/**"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/orgs/*/rulesets/**"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/actions/permissions/**"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/user/keys"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "{repo}/keys"
    }
   ],
   "graphqlPaths": [
    "/api/graphql"
   ],
   "writeNoQuery": true,
   "writeJSONOnly": true,
   "encodedSegments": [
    {
     "pattern": "**/contents/{enc*}"
    },
    {
     "pattern": "**/branches/{enc}"
    },
    {
     "pattern": "**/branches/{enc}/*"
    },
    {
     "pattern": "**/branches/{enc}/*/*"
    },
    {
     "pattern": "**/branches/{enc}/*/*/*"
    },
    {
     "pattern": "**/labels/{enc}"
    },
    {
     "pattern": "**/compare/{enc*}"
    },
    {
     "pattern": "**/git/ref/{enc*}"
    },
    {
     "pattern": "**/git/refs/{enc*}"
    },
    {
     "pattern": "**/git/matching-refs/{enc*}"
    },
    {
     "pattern": "**/releases/tags/{enc}"
    },
    {
     "pattern": "**/commits/{enc}"
    },
    {
     "pattern": "**/commits/{enc}/*"
    },
    {
     "pattern": "**/commits/{enc}/*/*"
    },
    {
     "pattern": "**/environments/{enc}"
    },
    {
     "pattern": "**/environments/{enc}/*"
    },
    {
     "pattern": "**/environments/{enc}/*/*"
    },
    {
     "pattern": "**/environments/{enc}/*/*/*"
    }
   ],
   "refuseFamilies": true,
   "undecodableRefused": true
  }
 },
