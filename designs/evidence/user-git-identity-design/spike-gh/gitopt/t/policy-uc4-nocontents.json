 "gitlab": {
  "mode": "deny",
  "matcher": "uc4",
  "restPrefix": "/api/v4/",
  "denyMutations": [
   "mergeRequestAccept"
  ],
  "stripHeaders": [
   "Authorization",
   "Private-Token",
   "Job-Token",
   "Deploy-Token",
   "X-Api-Key",
   "Cookie",
   "Proxy-Authorization",
   "Sudo"
  ],
  "uc4": {
   "default": "allow",
   "rules": [
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/projects/*/merge_requests/*/approve"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/projects/*/merge_requests/*/unapprove"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/projects/*/merge_requests/*/reset_approvals"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/projects/*/approvals"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/projects/*/approval_rules/**"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/projects/*/merge_requests/*/approvals"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/projects/*/merge_requests/*/approval_rules/**"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/projects/*/merge_requests/*/merge"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/projects/*/merge_requests/*/rebase"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/projects/*/merge_requests/*/cancel_merge_when_pipeline_succeeds"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/projects/*/repository/commits"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/projects/*/repository/files/**"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/projects/*/repository/branches"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/projects/*/repository/branches/**"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/projects/*/protected_branches/**"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/personal_access_tokens/self/rotate"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/user/keys"
    },
    {
     "action": "deny",
     "methods": [
      "WRITE"
     ],
     "path": "/projects/*/deploy_keys/**"
    }
   ],
   "graphqlPaths": [
    "/api/graphql"
   ],
   "writeNoQuery": true,
   "writeJSONOnly": true,
   "encodedSegments": [
    {
     "pattern": "api/v4/projects/{enc}",
     "refuseDecoded": [
      "merge_requests",
      "issues",
      "repository",
      "protected_branches",
      "deploy_keys",
      "approval_rules",
      "approvals",
      "pipelines",
      "hooks",
      "members"
     ]
    },
    {
     "pattern": "api/v4/projects/{enc}/*",
     "refuseDecoded": [
      "merge_requests",
      "issues",
      "repository",
      "protected_branches",
      "deploy_keys",
      "approval_rules",
      "approvals",
      "pipelines",
      "hooks",
      "members"
     ]
    },
    {
     "pattern": "api/v4/projects/{enc}/*/*",
     "refuseDecoded": [
      "merge_requests",
      "issues",
      "repository",
      "protected_branches",
      "deploy_keys",
      "approval_rules",
      "approvals",
      "pipelines",
      "hooks",
      "members"
     ]
    },
    {
     "pattern": "api/v4/projects/{enc}/*/*/*",
     "refuseDecoded": [
      "merge_requests",
      "issues",
      "repository",
      "protected_branches",
      "deploy_keys",
      "approval_rules",
      "approvals",
      "pipelines",
      "hooks",
      "members"
     ]
    },
    {
     "pattern": "api/v4/projects/{enc}/*/*/*/*",
     "refuseDecoded": [
      "merge_requests",
      "issues",
      "repository",
      "protected_branches",
      "deploy_keys",
      "approval_rules",
      "approvals",
      "pipelines",
      "hooks",
      "members"
     ]
    },
    {
     "pattern": "api/v4/projects/{enc}/*/*/*/*/*",
     "refuseDecoded": [
      "merge_requests",
      "issues",
      "repository",
      "protected_branches",
      "deploy_keys",
      "approval_rules",
      "approvals",
      "pipelines",
      "hooks",
      "members"
     ]
    },
    {
     "pattern": "api/v4/groups/{enc}",
     "refuseDecoded": [
      "merge_requests",
      "issues",
      "repository",
      "protected_branches",
      "deploy_keys",
      "approval_rules",
      "approvals",
      "pipelines",
      "hooks",
      "members"
     ]
    },
    {
     "pattern": "api/v4/groups/{enc}/*",
     "refuseDecoded": [
      "merge_requests",
      "issues",
      "repository",
      "protected_branches",
      "deploy_keys",
      "approval_rules",
      "approvals",
      "pipelines",
      "hooks",
      "members"
     ]
    },
    {
     "pattern": "api/v4/groups/{enc}/*/*",
     "refuseDecoded": [
      "merge_requests",
      "issues",
      "repository",
      "protected_branches",
      "deploy_keys",
      "approval_rules",
      "approvals",
      "pipelines",
      "hooks",
      "members"
     ]
    },
    {
     "pattern": "**/repository/branches/{enc}"
    },
    {
     "pattern": "**/repository/branches/{enc}/*"
    },
    {
     "pattern": "**/repository/files/{enc}"
    },
    {
     "pattern": "**/repository/files/{enc}/*"
    },
    {
     "pattern": "**/repository/tags/{enc}"
    },
    {
     "pattern": "**/repository/commits/{enc}"
    },
    {
     "pattern": "**/repository/commits/{enc}/*"
    },
    {
     "pattern": "**/repository/tree/{enc}"
    },
    {
     "pattern": "**/labels/{enc}"
    },
    {
     "pattern": "**/wikis/{enc}"
    }
   ],
   "refuseFamilies": true,
   "denyBodyKeys": [
    "merge_when_pipeline_succeeds",
    "auto_merge"
   ],
   "undecodableRefused": true,
   "bodyPatterns": [
    "(?i)^\\s*/(approve|lgtm|unapprove|merge|rebase|submit_review|target_branch|run_pipeline)\\b"
   ]
  }
 },
 "generic": {
  "mode": "deny",
  "matcher": "uc4",
  "restPrefix": "/",
  "denyMutations": [
   "addComment"
  ],
  "stripHeaders": [
   "Authorization",
   "Cookie"
  ],
  "uc4": {
   "default": "allow",
   "rules": [
    {
     "action": "deny",
     "methods": [
      "DELETE"
     ],
     "path": "/rest/api/*/issue/*"
    }
   ],
   "graphqlPaths": [
    "/graphql"
   ]
  }
 },
 "genericb": {
  "mode": "deny",
  "matcher": "uc4",
  "restPrefix": "/",
  "stripHeaders": [
   "Authorization",
   "Cookie"
  ],
  "uc4": {
   "default": "allow",
   "bodyPatterns": [
    "(?i)^\\s*/(lgtm|approve)\\b"
   ]
  }
 }
