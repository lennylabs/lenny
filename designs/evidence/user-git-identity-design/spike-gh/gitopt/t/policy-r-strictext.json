 "gitlab": {
  "mode": "deny",
  "restPrefix": "/api/v4",
  "graphqlPath": "/api/graphql",
  "maxBody": 262144,
  "lexStrict": true,
  "canonicalForward": true,
  "maxDepth": 64,
  "maxTokens": 15000,
  "denyMutations": [
   "mergeRequestAccept"
  ],
  "denyRest": [
   {
    "method": "POST",
    "path": ".../merge_requests/{n}/approve"
   },
   {
    "method": "POST",
    "path": ".../merge_requests/{n}/unapprove"
   },
   {
    "method": "PUT",
    "path": ".../merge_requests/{n}/merge"
   },
   {
    "method": "PUT",
    "path": ".../merge_requests/{n}/rebase"
   },
   {
    "method": "PUT",
    "path": ".../merge_requests/{n}/reset_approvals"
   },
   {
    "method": "POST",
    "path": ".../merge_requests/{n}/cancel_merge_when_pipeline_succeeds"
   }
  ],
  "stripHeaders": [
   "Authorization",
   "Private-Token",
   "Job-Token",
   "Sudo"
  ],
  "bodyRules": [
   {
    "path": ".../merge_requests",
    "regex": "(?:^|[\\r\\n\\x0b\\x0c\\x{85}\\x{2028}\\x{2029}])[ \\t]*/(?:approve|unapprove|merge|rebase)\\b"
   },
   {
    "path": ".../merge_requests/{n}",
    "regex": "(?:^|[\\r\\n\\x0b\\x0c\\x{85}\\x{2028}\\x{2029}])[ \\t]*/(?:approve|unapprove|merge|rebase)\\b"
   },
   {
    "path": ".../notes",
    "regex": "(?:^|[\\r\\n\\x0b\\x0c\\x{85}\\x{2028}\\x{2029}])[ \\t]*/(?:approve|unapprove|merge|rebase)\\b"
   },
   {
    "path": ".../discussions",
    "regex": "(?:^|[\\r\\n\\x0b\\x0c\\x{85}\\x{2028}\\x{2029}])[ \\t]*/(?:approve|unapprove|merge|rebase)\\b"
   }
  ],
  "matcher": "strict",
  "apiPrefixes": [
   "/api/v4",
   "/api/graphql"
  ],
  "encodedPaths": [
   "/api/v4/projects/{enc}",
   "/api/v4/projects/{enc}/**",
   "/api/v4/projects/{enc}/*",
   "/api/v4/projects/{enc}/*/*",
   "/api/v4/projects/{enc}/*/*/*",
   "/api/v4/projects/{enc}/*/*/*/*",
   "/api/v4/groups/{enc}",
   "/api/v4/groups/{enc}/*",
   "**/repository/branches/{enc}",
   "**/repository/files/{enc}",
   "**/repository/files/{enc}/*",
   "**/repository/tags/{enc}",
   "**/repository/commits/{enc}",
   "**/repository/commits/{enc}/*",
   "**/labels/{enc}",
   "**/wikis/{enc}",
   "**/repository/tree/{enc}"
  ]
 }
}