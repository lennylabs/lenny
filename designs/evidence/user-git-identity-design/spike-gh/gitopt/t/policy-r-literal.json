{
 "ghes": {
  "mode": "deny",
  "restPrefix": "/api/v3",
  "graphqlPath": "/api/graphql",
  "maxBody": 262144,
  "lexStrict": true,
  "canonicalForward": true,
  "maxDepth": 64,
  "maxTokens": 15000,
  "denyMutations": [
   "addPullRequestReview",
   "submitPullRequestReview",
   "updatePullRequestReview",
   "deletePullRequestReview",
   "dismissPullRequestReview",
   "mergePullRequest",
   "enablePullRequestAutoMerge",
   "disablePullRequestAutoMerge",
   "enqueuePullRequest",
   "dequeuePullRequest",
   "updatePullRequestBranch",
   "revertPullRequest",
   "mergeBranch",
   "createCommitOnBranch",
   "createRef",
   "updateRef",
   "updateRefs",
   "deleteRef"
  ],
  "denyRest": [
   {
    "method": "POST",
    "path": ".../pulls/{n}/reviews"
   },
   {
    "method": "POST",
    "path": ".../pulls/{n}/reviews/{id}/events"
   },
   {
    "method": "PUT",
    "path": ".../pulls/{n}/merge"
   },
   {
    "method": "PUT",
    "path": ".../pulls/{n}/update-branch"
   },
   {
    "method": "POST",
    "path": ".../merges"
   },
   {
    "method": "POST",
    "path": ".../git/refs/**"
   },
   {
    "method": "PATCH",
    "path": ".../git/refs/**"
   },
   {
    "method": "DELETE",
    "path": ".../git/refs/**"
   },
   {
    "method": "POST",
    "path": ".../git/refs"
   },
   {
    "method": "PATCH",
    "path": ".../git/refs"
   },
   {
    "method": "DELETE",
    "path": ".../git/refs"
   }
  ],
  "stripHeaders": [
   "Authorization"
  ],
  "matcher": "literal",
  "apiPrefixes": [
   "/api/v3",
   "/api/graphql",
   "/api/uploads"
  ],
  "encodedPaths": [
   "**/contents/{enc}",
   "**/branches/{enc}",
   "**/branches/{enc}/*",
   "**/labels/{enc}",
   "**/compare/{enc}",
   "**/git/ref/{enc}",
   "**/git/refs/{enc}",
   "**/git/matching-refs/{enc}",
   "**/releases/tags/{enc}",
   "**/commits/{enc}",
   "**/commits/{enc}/*",
   "**/environments/{enc}",
   "**/environments/{enc}/*",
   "**/secrets/{enc}",
   "**/variables/{enc}",
   "**/topics/{enc}"
  ]
 },
