   "revertPullRequest",
   "mergeBranch",
   "createCommitOnBranch",
   "createRef",
   "updateRef",
   "updateRefs",
   "deleteRef"
  ],
  "denyRest": [
   {
    "method": "POST",
    "path": ".../pulls/{n}/reviews"
   },
   {
    "method": "POST",
    "path": ".../pulls/{n}/reviews/{id}/events"
   },
   {
    "method": "PUT",
    "path": ".../pulls/{n}/merge"
   },
   {
    "method": "PUT",
    "path": ".../pulls/{n}/update-branch"
   },
   {
    "method": "POST",
    "path": ".../merges"
   },
   {
    "method": "POST",
    "path": ".../git/refs/**"
   },
   {
    "method": "PATCH",
    "path": ".../git/refs/**"
   },
   {
    "method": "DELETE",
    "path": ".../git/refs/**"
   },
   {
    "method": "POST",
    "path": ".../git/refs"
   },
   {
    "method": "PATCH",
    "path": ".../git/refs"
   },
   {
    "method": "DELETE",
    "path": ".../git/refs"
   }
  ],
  "stripHeaders": [
   "Authorization"
  ],
  "matcher": "literal",
  "apiPrefixes": [],
  "encodedPaths": [
   "**/contents/{enc}",
   "**/branches/{enc}",
   "**/branches/{enc}/*",
   "**/labels/{enc}",
   "**/compare/{enc}",
   "**/git/ref/{enc}",
   "**/git/refs/{enc}",
