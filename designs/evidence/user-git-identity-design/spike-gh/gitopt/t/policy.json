{
 "ghes": {
  "restPrefix": "/api/v3",
  "graphqlPath": "/api/graphql",
  "maxBody": 262144,
  "rest": [
   {
    "method": "GET",
    "path": "/"
   },
   {
    "method": "GET",
    "path": "/meta"
   },
   {
    "method": "GET",
    "path": "/user"
   },
   {
    "method": "GET",
    "path": "/repos/{o}/{r}"
   },
   {
    "method": "GET",
    "path": "/repos/{o}/{r}/readme"
   },
   {
    "method": "GET",
    "path": "/repos/{o}/{r}/pulls",
    "query": [
     "state",
     "head",
     "base",
     "sort",
     "direction",
     "per_page",
     "page"
    ]
   },
   {
    "method": "GET",
    "path": "/repos/{o}/{r}/pulls/{n}"
   },
   {
    "method": "POST",
    "path": "/repos/{o}/{r}/pulls"
   }
  ],
  "graphqlQueries": [
   "repository",
   "viewer",
   "organization",
   "node",
   "search",
   "__type"
  ],
  "graphqlMutations": [
   "createPullRequest",
   "updatePullRequest",
   "requestReviews",
   "requestReviewsByLogin",
   "replaceActorsForAssignable",
   "addProjectV2ItemById"
  ],
  "mutationInputAllow": {
   "updatePullRequest": [
    "pullRequestId",
    "assigneeIds",
    "labelIds",
    "projectIds",
    "milestoneId"
   ]
  },
  "headers": [
   "Accept",
   "Accept-Encoding",
   "Authorization",
   "Content-Type",
   "Content-Length",
   "User-Agent",
   "X-Github-Api-Version",
   "Graphql-Features",
   "X-Gh-Cache-Ttl",
   "Time-Zone"
  ],
  "lexStrict": true,
  "maxDepth": 32
 },
 "ghcom": {
  "restPrefix": "",
  "graphqlPath": "/graphql",
  "maxBody": 262144,
  "rest": [
   {
    "method": "GET",
    "path": "/"
   },
   {
    "method": "GET",
    "path": "/user"
   },
   {
    "method": "GET",
    "path": "/repos/{o}/{r}"
   },
   {
    "method": "GET",
    "path": "/repos/{o}/{r}/readme"
   },
   {
    "method": "GET",
    "path": "/repos/{o}/{r}/pulls",
    "query": [
     "state",
     "head",
     "base",
     "sort",
     "direction",
     "per_page",
     "page"
    ]
   },
   {
    "method": "GET",
    "path": "/repos/{o}/{r}/pulls/{n}"
   },
   {
    "method": "POST",
    "path": "/repos/{o}/{r}/pulls"
   }
  ],
  "graphqlQueries": [
   "repository",
   "viewer",
   "organization",
   "node",
   "search",
   "__type"
  ],
  "graphqlMutations": [
   "createPullRequest",
   "updatePullRequest",
   "requestReviews",
   "requestReviewsByLogin",
   "replaceActorsForAssignable",
   "addProjectV2ItemById"
  ],
  "mutationInputAllow": {
   "updatePullRequest": [
    "pullRequestId",
    "assigneeIds",
    "labelIds",
    "projectIds",
    "milestoneId"
   ]
  },
  "headers": [
   "Accept",
   "Accept-Encoding",
   "Authorization",
   "Content-Type",
   "Content-Length",
   "User-Agent",
   "X-Github-Api-Version",
   "Graphql-Features",
   "X-Gh-Cache-Ttl",
   "Time-Zone"
  ],
  "lexStrict": true,
  "maxDepth": 32
 },
 "gitlab": {
  "restPrefix": "/api/v4",
  "graphqlPath": "/api/graphql",
  "maxBody": 262144,
  "encodedProjectSegments": true,
  "lexStrict": true,
  "maxDepth": 32,
  "rest": [
   {
    "method": "GET",
    "path": "/user"
   },
   {
    "method": "GET",
    "path": "/users",
    "query": [
     "per_page",
     "username",
     "page"
    ]
   },
   {
    "method": "GET",
    "path": "/projects/{project}",
    "query": [
     "license",
     "with_custom_attributes",
     "statistics"
    ]
   },
   {
    "method": "GET",
    "path": "/projects/{project}/milestones",
    "query": [
     "include_parent_milestones",
     "per_page",
     "title",
     "page"
    ]
   },
   {
    "method": "GET",
    "path": "/projects/{project}/merge_requests",
    "query": [
     "page",
     "per_page",
     "state",
     "labels",
     "author_username",
     "reviewer_username",
     "assignee_username",
     "search",
     "source_branch",
     "target_branch"
    ]
   },
   {
    "method": "GET",
    "path": "/projects/{project}/merge_requests/{n}"
   },
   {
    "method": "GET",
    "path": "/projects/{project}/merge_requests/{n}/discussions",
    "query": [
     "page",
     "per_page",
     "sort"
    ]
   },
   {
    "method": "POST",
    "path": "/projects/{project}/merge_requests"
   }
  ],
  "graphqlQueries": [
   "currentUser",
   "project"
  ],
  "graphqlMutations": [],
  "headers": [
   "Accept",
   "Accept-Encoding",
   "Private-Token",
   "User-Agent",
   "Content-Type",
   "Content-Length"
  ],
  "bodyDenyRegex": [
   "(?:^|[\\r\\n\\x0b\\x0c\\x{85}\\x{2028}\\x{2029}])[ \\t]*/[a-z_]+"
  ]
 }
}