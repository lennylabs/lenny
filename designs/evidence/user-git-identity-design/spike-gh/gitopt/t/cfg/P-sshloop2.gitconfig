[url "http://"]
    insteadOf = https://
[http]
    proxy = http://127.0.0.1:3129
[credential]
    helper =
[http]
    followRedirects = initial
[transfer]
    fsckObjects = true
[user]
    name = alice
    email = alice@acme.com
[safe]
    directory = *
[protocol "file"]
    allow = never
[url "http://127.0.0.1:3129/ssh/"]
    insteadOf = ssh://
[url "http://127.0.0.1:3129/scp/"]
    insteadOf = git@
[http "http://127.0.0.1:3129/"]
    proxy =
