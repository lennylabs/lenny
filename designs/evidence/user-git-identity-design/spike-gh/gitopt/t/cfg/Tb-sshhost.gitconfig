[http]
    proxy = http://127.0.0.1:3128
    sslCAInfo = /s/bundle.pem
[credential]
    helper =
[http]
    followRedirects = initial
[transfer]
    fsckObjects = true
[user]
    name = alice
    email = alice@acme.com
[safe]
    directory = *
[protocol "file"]
    allow = never
[url "https://ghes.example.test/"]
    insteadOf = git@ghes.example.test:
    insteadOf = ssh://git@ghes.example.test/
[url "https://github.com/"]
    insteadOf = git@github.com:
    insteadOf = ssh://git@github.com/
[url "https://gitlab.example.test/"]
    insteadOf = git@gitlab.example.test:
    insteadOf = ssh://git@gitlab.example.test/
