[url "http://127.0.0.1:3129/https/"]
    pushInsteadOf = https://
[http]
    proxy = http://127.0.0.1:3128
    sslCAInfo = /s/bundle.pem
[credential]
    helper =
[http]
    followRedirects = initial
[transfer]
    fsckObjects = true
[user]
    name = alice
    email = alice@acme.com
[safe]
    directory = *
[protocol "file"]
    allow = never
