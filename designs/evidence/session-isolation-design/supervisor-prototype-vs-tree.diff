+/*
+ * Non-blocking sends and ppoll bound the wait. SO_SNDTIMEO would be
+ * shorter, but gVisor accepts it on a Unix stream socket and does not
+ * enforce it.
+ */
+int sv_send_all(int fd, const void *buf, sv_size n, void *control, sv_size controllen)
+{
+	const char *p = buf;
+	int sent = 0, polls = 0;
+	sv_u64 deadline = sv_now_ms() + SV_SEND_TIMEOUT_MS; /* moves with each byte of progress */
+	while (n) {
+		struct sv_iovec iov = {(void *)p, n};
+		struct sv_msghdr m = {SV_NULL, 0, &iov, 1, control, controllen, 0};
+		sv_ssize r = sv_sendmsg(fd, &m, SV_MSG_NOSIGNAL | SV_MSG_DONTWAIT);
+		if (r == -SV_EAGAIN) {
+			/*
+			 * The handled signals stay blocked, so only room or the deadline ends
+			 * the wait. A socket that reports room and then refuses it again is
+			 * given SV_SEND_MAX_POLLS waits, so the two cannot disagree in a spin.
+			 */
+			sv_u64 now = sv_now_ms();
+			struct sv_pollfd pfd = {fd, SV_POLLOUT, 0};
+			struct sv_timespec ts = sv_ts_until(now, deadline);
+			if (now >= deadline || ++polls > SV_SEND_MAX_POLLS || sv_ppoll(&pfd, 1, &ts, SV_NULL) <= 0)
+				return -SV_EAGAIN;
+			continue;
+		}
+		if (r <= 0)
+			return sent || r == 0 ? -SV_EPIPE : (int)r;
+		sent = 1;
+		polls = 0;
+		deadline = sv_now_ms() + SV_SEND_TIMEOUT_MS;
+		p += r;
+		n -= (sv_size)r;
+		control = SV_NULL; /* the descriptors went with the first byte */
+		controllen = 0;
+	}
+	return 0;
+}
