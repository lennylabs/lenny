+sv_size sv_fmt_setupdone(char *out, sv_u64 gen, sv_u64 id, int got, int st, enum sv_error err,
+			 enum sv_setup_why why, int err_no)
+{
+	sv_size n = 0;
+	n = sv_cat(out, n, "{\"type\":\"setupdone\",\"gen\":");
+	n = sv_cat_u64(out, n, gen);
+	n = sv_cat(out, n, ",\"id\":");
+	n = sv_cat_u64(out, n, id);
+	if (got && SV_WIFSIGNALED(st)) {
+		n = sv_cat(out, n, ",\"signal\":");
+		n = sv_cat_u64(out, n, (sv_u64)SV_WTERMSIG(st));
+	} else if (got) {
+		n = sv_cat(out, n, ",\"exit\":");
+		n = sv_cat_u64(out, n, (sv_u64)SV_WEXITSTATUS(st));
+	}
+	if (err != SV_ERR_NONE) {
+		n = sv_cat(out, n, ",\"error\":\"");
+		n = sv_cat(out, n, sv_error_name(err));
+		n = sv_cat(out, n, "\"");
+	}
+	if (why != SV_WHY_NONE) {
+		n = sv_cat(out, n, why == SV_WHY_CWD ? ",\"reason\":\"cwd\",\"errno\":" : ",\"reason\":\"exec\",\"errno\":");
+		n = sv_cat_u64(out, n, (sv_u64)err_no);
 	}
 	n = sv_cat(out, n, "}\n");
 	return n;
