+/* sv_uints decodes an array of integers into req->nums. */
+static int sv_uints(struct sv_parser *p)
+{
+	struct sv_request *r = p->req;
+	if (sv_expect(p, '['))
+		return -1;
+	r->nnums = 0;
+	if (sv_peek(p, ']')) {
+		p->i++;
+		return 0;
+	}
+	for (;;) {
+		if (r->nnums >= SV_FS_MAX * 4 || sv_uint(p, &r->nums[r->nnums]))
+			return -1;
+		r->nnums++;
+		if (sv_peek(p, ',')) {
+			p->i++;
+			continue;
+		}
+		return sv_expect(p, ']');
+	}
+}
