+/* sv_fs_keys is the member set an fs request with op requires, and checks the array lengths. */
+static unsigned sv_fs_keys(const struct sv_request *r, unsigned base)
+{
+	unsigned k = base | (1u << SV_K_OP) | (1u << SV_K_PATHS) | (1u << SV_K_ROOT);
+	int want_nums = 0, want_targets = 0;
+	switch (r->fs_op) {
+	case SV_FS_MKFILE:
+	case SV_FS_MKDIR:
+	case SV_FS_MKFIFO:
+	case SV_FS_CHMOD:
+		want_nums = r->npaths;
+		break;
+	case SV_FS_UTIMENS:
+		want_nums = 4 * r->npaths;
+		break;
+	case SV_FS_SYMLINK:
+	case SV_FS_LINK:
+		want_targets = r->npaths;
+		break;
+	case SV_FS_NONE:
+		return 0;
+	default:
+		break;
+	}
+	if (r->npaths > SV_FS_MAX || r->nnums != want_nums || r->ntargets != want_targets)
+		return 0;
+	if (want_nums)
+		k |= 1u << SV_K_NUMS;
+	if (want_targets)
+		k |= 1u << SV_K_TARGETS;
+	return k;
+}
