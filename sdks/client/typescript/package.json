{
  "name": "@lennylabs/client-sdk",
  "version": "0.1.0",
  "description": "Official TypeScript/JavaScript client SDK for the Lenny gateway",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lennylabs/client-sdk-ts.git"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "test-helper"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:pkgjson": "node scripts/write-dist-pkgjson.mjs",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:pkgjson",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
