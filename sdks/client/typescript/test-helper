#!/usr/bin/env node
// SPDX-License-Identifier: MIT

// Entry point the tier-3 SDK contract harness
// (tests/tier3_contract/sdks/harness) execs for the TypeScript client
// SDK. The harness spawns this file directly as a subprocess and
// speaks the JSON-line protocol over stdin/stdout.
//
// The file is a thin launcher: it imports the compiled ESM helper
// produced by `npm run build` (dist/esm/test-helper.js). The package
// declares "type": "module", so this extensionless file is loaded as
// an ES module. The build must run before the harness spawns the
// helper; the Go test that drives this helper runs
// `npm install && npm run build` first.

import { dirname, join } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

const here = dirname(fileURLToPath(import.meta.url));
const helper = join(here, 'dist', 'esm', 'test-helper.js');

try {
  await import(pathToFileURL(helper).href);
} catch (err) {
  process.stderr.write(
    'test-helper: cannot load ' +
      helper +
      '; run `npm install && npm run build` in sdks/client/typescript first\n',
  );
  process.stderr.write(String((err && err.stack) || err) + '\n');
  process.exit(1);
}
