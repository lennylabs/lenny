{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lenny.test/schemas/diagnostics_credential_pool.json",
  "title": "CredentialPoolDiagnosis response body (spec 25.6)",
  "description": "The GET /v1/admin/diagnostics/credential-pools/{name} response. Pins the CredentialPoolDiagnosis struct: the pool identity, the health status, the utilization ratio, the suggestedActions array, and the optional hotKeys list and canonical degradation envelope. additionalProperties is false so a renamed or dropped field fails the contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pool", "status", "utilization", "suggestedActions"],
  "properties": {
    "pool": { "type": "string" },
    "status": { "type": "string" },
    "utilization": { "type": "number" },
    "hotKeys": {
      "type": "array",
      "items": { "type": "string" }
    },
    "suggestedActions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "endpoint", "reasoning"],
        "properties": {
          "action": { "type": "string" },
          "endpoint": { "type": "string" },
          "body": {},
          "reasoning": { "type": "string" },
          "runbook": { "type": "string" },
          "confidence": { "type": "number" },
          "risk": { "type": "string" }
        }
      }
    },
    "degradation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "type": "string", "enum": ["healthy", "degraded", "failed"] },
        "primarySource": { "type": "string" },
        "actualSource": { "type": "string" },
        "fallbackPath": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number" },
        "unavailableFields": { "type": "array", "items": { "type": "string" } },
        "thresholdSource": { "type": "string", "enum": ["operator-customized", "compiled-in-defaults"] },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "since": { "type": "string" }
      }
    }
  }
}
