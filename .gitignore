.DS_Store
tmp/

# Built Go binaries left in the repo root by `go build` against package
# subdirectories. The names match the cmd/ and tests/tier7b_load_kind/scenarios/
# package directories.
/lenny-test
/lenny-test-cached
/lenny-adapter
/lenny-compliance
/lenny-controller
/lenny-ctl
/lenny-gateway
/lenny-migrate
/lenny-token-service
/lenny-webhook
/lenny-loadrunner
/lenny-loadctl
/lenny-ops
/cloud-metrics-collector
/echo
/streaming-echo
/startup_latency

# Makefile `build` target output directory.
/bin/

tests/results/

# Terraform working state — never committed. Operators applying the
# per-provider modules under deploy/terraform/cloud/<provider>/ end up
# with these alongside the .tf sources; commit only the .tf files.
**/.terraform/
**/.terraform.lock.hcl
**/.terraform.tfstate.lock.info
**/terraform.tfstate
**/terraform.tfstate.backup
**/terraform.tfstate.*.backup
**/*.tfstate
**/*.tfstate.backup

# Per-release tfvars rendered by scripts/cloud/<provider>/up.sh.
# Filename pattern: <release>.tfvars.json.
deploy/terraform/cloud/*/*.tfvars.json

# Rendered Helm values overlays produced by
# scripts/cloud/<provider>/render-values.sh. The committed source is
# the renderer script + the chart's values.yaml; the rendered file
# carries per-release URLs / digests and stays out of git.
scripts/cloud/*/values-cloud-*.yaml
.claude/scheduled_tasks.lock
