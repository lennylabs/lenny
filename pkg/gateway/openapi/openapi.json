{
  "openapi": "3.1.0",
  "info": {
    "title": "Lenny Gateway API",
    "description": "Lenny session, blob, and admin endpoints. See spec/15_external-api-surface.md.",
    "version": "0.1.0",
    "license": { "name": "MIT" }
  },
  "servers": [
    { "url": "/", "description": "Gateway root" }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "§10.2 OIDC/OAuth 2.1 access token."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code":    { "type": "string" },
              "message": { "type": "string" },
              "details": { "type": "object", "additionalProperties": true }
            }
          }
        }
      },
      "Session": {
        "type": "object",
        "required": ["id", "tenantId", "state", "createdAt", "updatedAt"],
        "properties": {
          "id":         { "type": "string" },
          "tenantId":   { "type": "string" },
          "userId":     { "type": "string" },
          "runtimeRef": { "type": "string" },
          "state": {
            "type": "string",
            "enum": ["created","finalizing","ready","starting","running","suspended","resume_pending","awaiting_client_action","completed","failed","cancelled","expired"]
          },
          "createdAt":  { "type": "string", "format": "date-time" },
          "updatedAt":  { "type": "string", "format": "date-time" },
          "failureClass": {
            "type": "string",
            "enum": ["runtime_failure","starting_timeout","budget_keys_expired","workspace_seal_timeout","derive_failure"]
          }
        }
      },
      "CreateSessionRequest": {
        "type": "object",
        "required": ["runtimeRef"],
        "properties": {
          "runtimeRef":       { "type": "string" },
          "userId":           { "type": "string" },
          "workspacePlan":    { "type": "object", "additionalProperties": true },
          "isolationProfile": { "type": "string", "enum": ["standard","sandboxed","microvm"] }
        }
      },
      "CreateSessionResponse": {
        "type": "object",
        "required": ["id", "tenantId", "state", "uploadToken", "sessionIsolationLevel"],
        "allOf": [
          { "$ref": "#/components/schemas/Session" },
          {
            "type": "object",
            "properties": {
              "uploadToken": { "type": "string" },
              "sessionIsolationLevel": {
                "type": "object",
                "required": ["executionMode", "isolationProfile", "podReuse", "residualStateWarning"],
                "properties": {
                  "executionMode":        { "type": "string", "enum": ["session","task","concurrent"] },
                  "isolationProfile":     { "type": "string", "enum": ["standard","sandboxed","microvm"] },
                  "podReuse":             { "type": "boolean" },
                  "scrubPolicy":          { "type": "string" },
                  "residualStateWarning": { "type": "boolean" }
                }
              }
            }
          }
        ]
      },
      "DeriveRequest": {
        "type": "object",
        "properties": {
          "runtimeRef":              { "type": "string" },
          "targetPool":              { "type": "string" },
          "targetIsolationProfile":  { "type": "string", "enum": ["standard","sandboxed","microvm"] },
          "userId":                  { "type": "string" },
          "allowStale":              { "type": "boolean", "default": false },
          "allowIsolationDowngrade": { "type": "boolean", "default": false },
          "ticketId":                { "type": "string" }
        }
      },
      "UploadResponse": {
        "type": "object",
        "required": ["uploadRef", "size"],
        "properties": {
          "uploadRef": { "type": "string", "description": "§4.5 lenny-blob:// URI" },
          "mimeType":  { "type": "string" },
          "size":      { "type": "integer", "format": "int64" }
        }
      },
      "ExtendRetentionRequest": {
        "type": "object",
        "required": ["ttlSeconds"],
        "properties": {
          "ttlSeconds": { "type": "integer", "minimum": 1 }
        }
      },
      "Tenant": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id":                  { "type": "string" },
          "displayName":         { "type": "string" },
          "complianceProfile":   { "type": "string" },
          "dataResidencyRegion": { "type": "string" },
          "workspaceTier":       { "type": "string" },
          "createdAt":           { "type": "string", "format": "date-time" },
          "updatedAt":           { "type": "string", "format": "date-time" },
          "deletedAt":           { "type": "string", "format": "date-time" }
        }
      },
      "Runtime": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name":             { "type": "string" },
          "type":             { "type": "string", "enum": ["agent","mcp"] },
          "image":            { "type": "string" },
          "executionMode":    { "type": "string", "enum": ["session","task","concurrent"] },
          "isolationProfile": { "type": "string", "enum": ["standard","sandboxed","microvm"] },
          "integrationLevel": { "type": "string", "enum": ["basic","standard","full"] },
          "description":      { "type": "string" },
          "createdAt":        { "type": "string", "format": "date-time" },
          "updatedAt":        { "type": "string", "format": "date-time" },
          "deletedAt":        { "type": "string", "format": "date-time" }
        }
      },
      "User": {
        "type": "object",
        "required": ["subject", "tenantId"],
        "properties": {
          "subject":     { "type": "string" },
          "tenantId":    { "type": "string" },
          "email":       { "type": "string" },
          "displayName": { "type": "string" },
          "roles":       { "type": "array", "items": { "type": "string", "enum": ["platform-admin","tenant-admin","tenant-viewer","billing-viewer","user"] } },
          "disabled":    { "type": "boolean" },
          "createdAt":   { "type": "string", "format": "date-time" },
          "updatedAt":   { "type": "string", "format": "date-time" },
          "deletedAt":   { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness probe",
        "security": [],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "summary": "Create a session",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateSessionRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreateSessionResponse" }
              }
            }
          },
          "400": { "description": "Validation failure", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "get": {
        "summary": "List sessions",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "state",      "in": "query", "schema": { "type": "string" } },
          { "name": "runtime",    "in": "query", "schema": { "type": "string" } },
          { "name": "failureClass", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sessions": { "type": "array", "items": { "$ref": "#/components/schemas/Session" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{id}": {
      "get": {
        "summary": "Get session",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } } },
          "404": { "description": "Not found",  "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "delete": {
        "summary": "Cancel session",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Cancelled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } } }
        }
      }
    },
    "/v1/sessions/{id}/finalize": {
      "post": {
        "summary": "Finalize workspace",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" }, "409": { "description": "Invalid state transition" } }
      }
    },
    "/v1/sessions/{id}/start": {
      "post": {
        "summary": "Start the agent runtime",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" }, "409": { "description": "Invalid state transition" } }
      }
    },
    "/v1/sessions/{id}/interrupt": {
      "post": {
        "summary": "Interrupt the running agent",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/v1/sessions/{id}/terminate": {
      "post": {
        "summary": "Gracefully end the session",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/v1/sessions/{id}/resume": {
      "post": {
        "summary": "Resume after retry exhaustion",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/v1/sessions/{id}/derive": {
      "post": {
        "summary": "Derive a new session from this session's workspace snapshot",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeriveRequest" } } }
        },
        "responses": {
          "201": { "description": "Created" },
          "409": { "description": "DERIVE_ON_LIVE_SESSION" },
          "422": { "description": "ISOLATION_MONOTONICITY_VIOLATED" }
        }
      }
    },
    "/v1/sessions/{id}/upload": {
      "post": {
        "summary": "Upload a workspace file",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "X-Lenny-Upload-Token", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "*/*": { "schema": { "type": "string", "format": "binary" } } }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UploadResponse" } } } },
          "401": { "description": "UPLOAD_TOKEN_INVALID / UPLOAD_TOKEN_EXPIRED" },
          "403": { "description": "UPLOAD_TOKEN_MISMATCH" },
          "410": { "description": "UPLOAD_TOKEN_CONSUMED" },
          "413": { "description": "PAYLOAD_TOO_LARGE" }
        }
      }
    },
    "/v1/sessions/{id}/extend-retention": {
      "post": {
        "summary": "Extend artifact retention TTL",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExtendRetentionRequest" } } }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/v1/blobs/{ref}": {
      "get": {
        "summary": "Resolve a lenny-blob:// reference",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "ref", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "OK", "content": { "*/*": { "schema": { "type": "string", "format": "binary" } } } },
          "403": { "description": "Cross-tenant access denied" },
          "404": { "description": "Not found or expired" }
        }
      }
    },
    "/v1/admin/tenants": {
      "post": {
        "summary": "Create a tenant",
        "x-lenny-mcp-tool": "admin.create_tenant",
        "x-lenny-scope": "admin.tenants.write",
        "x-lenny-required-role": "platform-admin",
        "x-lenny-category": "tenant-management",
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Tenant" } } } },
        "responses": { "201": { "description": "Created" } }
      },
      "get": {
        "summary": "List tenants",
        "x-lenny-mcp-tool": "admin.list_tenants",
        "x-lenny-scope": "admin.tenants.read",
        "x-lenny-required-role": "platform-admin",
        "x-lenny-category": "tenant-management",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "includeDeleted", "in": "query", "schema": { "type": "boolean" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/v1/admin/tenants/{id}": {
      "get": {
        "summary": "Get a tenant",
        "x-lenny-mcp-tool": "admin.get_tenant",
        "x-lenny-scope": "admin.tenants.read",
        "x-lenny-required-role": "platform-admin",
        "x-lenny-category": "tenant-management",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      },
      "put": {
        "summary": "Update a tenant",
        "x-lenny-mcp-tool": "admin.update_tenant",
        "x-lenny-scope": "admin.tenants.write",
        "x-lenny-required-role": "platform-admin",
        "x-lenny-category": "tenant-management",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "summary": "Soft-delete a tenant",
        "x-lenny-mcp-tool": "admin.soft_delete_tenant",
        "x-lenny-scope": "admin.tenants.write",
        "x-lenny-required-role": "platform-admin",
        "x-lenny-category": "tenant-management",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/v1/admin/runtimes": {
      "post": {
        "summary": "Create a runtime",
        "x-lenny-mcp-tool": "admin.create_runtime",
        "x-lenny-scope": "admin.runtimes.write",
        "x-lenny-required-role": "platform-admin",
        "x-lenny-category": "runtime-management",
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Runtime" } } } },
        "responses": { "201": { "description": "Created" } }
      },
      "get": {
        "summary": "List runtimes",
        "x-lenny-mcp-tool": "admin.list_runtimes",
        "x-lenny-scope": "admin.runtimes.read",
        "x-lenny-required-role": "platform-admin",
        "x-lenny-category": "runtime-management",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/v1/admin/runtimes/{name}": {
      "get": {
        "summary": "Get a runtime",
        "x-lenny-mcp-tool": "admin.get_runtime",
        "x-lenny-scope": "admin.runtimes.read",
        "x-lenny-required-role": "platform-admin",
        "x-lenny-category": "runtime-management",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      },
      "put": {
        "summary": "Update a runtime",
        "x-lenny-mcp-tool": "admin.update_runtime",
        "x-lenny-scope": "admin.runtimes.write",
        "x-lenny-required-role": "platform-admin",
        "x-lenny-category": "runtime-management",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "summary": "Soft-delete a runtime",
        "x-lenny-mcp-tool": "admin.soft_delete_runtime",
        "x-lenny-scope": "admin.runtimes.write",
        "x-lenny-required-role": "platform-admin",
        "x-lenny-category": "runtime-management",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/v1/admin/users": {
      "post": {
        "summary": "Create a user",
        "x-lenny-mcp-tool": "admin.create_user",
        "x-lenny-scope": "admin.users.write",
        "x-lenny-required-role": "tenant-admin",
        "x-lenny-category": "user-management",
        "security": [{ "BearerAuth": [] }],
        "responses": { "201": { "description": "Created" } }
      },
      "get": {
        "summary": "List users",
        "x-lenny-mcp-tool": "admin.list_users",
        "x-lenny-scope": "admin.users.read",
        "x-lenny-required-role": "tenant-admin",
        "x-lenny-category": "user-management",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/v1/admin/users/{user_id}": {
      "get": {
        "summary": "Get a user",
        "x-lenny-mcp-tool": "admin.get_user",
        "x-lenny-scope": "admin.users.read",
        "x-lenny-required-role": "tenant-admin",
        "x-lenny-category": "user-management",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "user_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      },
      "put": {
        "summary": "Update a user",
        "x-lenny-mcp-tool": "admin.update_user",
        "x-lenny-scope": "admin.users.write",
        "x-lenny-required-role": "tenant-admin",
        "x-lenny-category": "user-management",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "user_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "summary": "Soft-delete a user",
        "x-lenny-mcp-tool": "admin.soft_delete_user",
        "x-lenny-scope": "admin.users.write",
        "x-lenny-required-role": "tenant-admin",
        "x-lenny-category": "user-management",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "user_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/v1/admin/bootstrap": {
      "post": {
        "summary": "Apply seed configuration (tenants + runtimes + users) with upsert semantics",
        "x-lenny-mcp-tool": "admin.bootstrap",
        "x-lenny-scope": "admin.bootstrap.write",
        "x-lenny-required-role": "platform-admin",
        "x-lenny-category": "platform-management",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Applied" }, "207": { "description": "Partial success" } }
      }
    }
  }
}
